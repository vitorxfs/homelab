# Cloudflare Tunnel
# Token gerado no dashboard do Cloudflare Zero Trust > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# n8n — URL pública usada para montar os endereços de webhook
# Deve ser o domínio público do n8n configurado no túnel Cloudflare
# Exemplo: https://n8n.vitorsanches.com/
N8N_WEBHOOK_URL=

# AI (Claude Code)
ANTHROPIC_API_KEY=

# Senha SSH para o usuário `claude` no container ai (porta 2222)
AI_SSH_PASSWORD=

# TTRSS (Tiny Tiny RSS)
# URL pública do TTRSS — necessária para o app montar links corretos
# Exemplo: https://ttrss.vitorsanches.com/
TTRSS_SELF_URL_PATH=
# Senha do banco postgres do TTRSS
TTRSS_DB_PASSWORD=
